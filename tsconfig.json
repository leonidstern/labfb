{
  // TypeScript checks labfb's plain JavaScript: no .ts files, no build, nothing emitted.
  // Types come from JSDoc comments, e.g. /** @type {HTMLTextAreaElement} */ (el).
  // The gate counts the errors and lets the count only go down (npm run typecheck lists them).
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"]
  },
  "files": ["src/comments.js", "local.mjs", "lib/dev.mjs", "api/lab-comments.mjs"]
}
